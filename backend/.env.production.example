############################################
# S.I.S API — modèle .env PRODUCTION
# Domaines :
#   Web  → https://sis-administration.com    (cPanel Node.js)
#   API  → https://v1.sis-administration.com (Laravel)
# Copier vers .env sur le serveur, puis :
#   php artisan key:generate
#   php artisan config:cache
############################################

APP_NAME=SIS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://v1.sis-administration.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sis
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="noreply@sis-administration.com"
MAIL_FROM_NAME="${APP_NAME}"

MEDIA_DISK=media
QUEUE_CONVERSIONS_BY_DEFAULT=true

# Bearer tokens — ne pas remplir (évite CSRF sur le login API).
SANCTUM_STATEFUL_DOMAINS=

# Front Next.js (CORS obligatoire) — origine exacte du navigateur
FRONTEND_URL=https://sis-administration.com
# Ajouter www si utilisé
FRONTEND_URLS=https://www.sis-administration.com

SIS_CONTROLE_ENFORCE_SITE_RADIUS=true
SIS_AFFAIRE_SUIVIE_PAR="SERVICE COMMERCIAL"
SIS_TELEPHONE_COMMERCIAL=

SIS_COMPANY_NAME="Société Ivoirienne de Sécurité"
# SIS_COMPANY_LEGAL=

# Compte développeur (console /developpeur) : absent par défaut en prod.
# Mettre à true + un mot de passe fort pour l'activer via `php artisan db:seed`.
SIS_SEED_DEVELOPER=false
# SIS_DEVELOPER_PASSWORD=
